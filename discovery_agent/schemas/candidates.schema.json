{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateList",
  "type": "object",
  "required": [
    "candidates",
    "searches_run",
    "unmet_needs"
  ],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "kind",
          "title",
          "need_ids",
          "target_windows",
          "why_relevant",
          "found_via"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^(internal\\.[a-z0-9_]+\\.[a-z0-9_]+|api\\.[a-z0-9_]+|vendor\\.[a-z0-9_]+|link\\.[a-z0-9_]+)$"
          },
          "kind": {
            "enum": [
              "internal",
              "public_api",
              "vendor_feed",
              "dataset_link"
            ]
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "need_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^N[0-9]+$"
            },
            "minItems": 1
          },
          "target_windows": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "why_relevant": {
            "type": "string"
          },
          "found_via": {
            "type": "string"
          },
          "suspected_issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canonical_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "searches_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_without_profiling": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "unmet_needs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}